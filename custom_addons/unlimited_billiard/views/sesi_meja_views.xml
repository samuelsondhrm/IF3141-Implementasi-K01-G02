<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- L-08 Denah dan Sesi Meja (FR-08) -->
    <record id="ub_sesi_meja_view_tree" model="ir.ui.view">
        <field name="name">ub.sesi.meja.tree</field>
        <field name="model">ub.sesi.meja</field>
        <field name="arch" type="xml">
            <tree decoration-danger="status == 'melewati_batas'" decoration-muted="status == 'selesai'">
                <field name="meja_id"/>
                <field name="partner_id" optional="show"/>
                <field name="jenis_tarif"/>
                <field name="jam_mulai"/>
                <field name="jam_batas" optional="hide"/>
                <field name="jam_selesai"/>
                <field name="durasi_menit"/>
                <field name="pricelist_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="biaya_sewa"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'berjalan'"
                       decoration-danger="status == 'melewati_batas'"
                       decoration-success="status == 'selesai'"/>
            </tree>
        </field>
    </record>

    <record id="ub_sesi_meja_view_form" model="ir.ui.view">
        <field name="name">ub.sesi.meja.form</field>
        <field name="model">ub.sesi.meja</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_selesai" type="object" string="Selesai Sesi" class="btn-primary"
                            invisible="status == 'selesai' or not id"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group string="Sesi">
                            <field name="meja_id" options="{'no_create': True, 'no_open': True}" readonly="id"/>
                            <field name="partner_id" options="{'no_create': True}" readonly="status == 'selesai'"/>
                            <field name="is_member"/>
                            <field name="jenis_tarif" readonly="id"/>
                            <field name="durasi_dipesan" invisible="jenis_tarif != 'durasi_tetap'"
                                   required="jenis_tarif == 'durasi_tetap'" readonly="id"/>
                            <field name="pos_order_id"/>
                        </group>
                        <group string="Waktu dan Biaya">
                            <field name="jam_mulai"/>
                            <field name="jam_batas" invisible="jenis_tarif != 'durasi_tetap'"/>
                            <field name="jam_selesai"/>
                            <field name="durasi_menit"/>
                            <field name="pricelist_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="biaya_sewa"/>
                            <field name="dibuka_oleh"/>
                            <field name="ditutup_oleh"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="ub_sesi_meja_view_search" model="ir.ui.view">
        <field name="name">ub.sesi.meja.search</field>
        <field name="model">ub.sesi.meja</field>
        <field name="arch" type="xml">
            <search>
                <field name="meja_id"/>
                <field name="partner_id"/>
                <filter name="filter_aktif" string="Sedang Berjalan" domain="[('status', '!=', 'selesai')]"/>
                <filter name="filter_hari_ini" string="Hari Ini"
                        domain="[('jam_mulai', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_meja" string="Meja" context="{'group_by': 'meja_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ub_sesi_meja_action" model="ir.actions.act_window">
        <field name="name">Sesi Meja</field>
        <field name="res_model">ub.sesi.meja</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_aktif': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada sesi meja berjalan</p>
            <p>Mulai sesi dari tombol Mulai Sesi di layar pesanan POS, atau buat di sini.</p>
        </field>
    </record>

    <menuitem id="menu_ub_sesi_meja" name="Sesi Meja" parent="point_of_sale.menu_point_of_sale"
              action="ub_sesi_meja_action" groups="point_of_sale.group_pos_user" sequence="5"/>
</odoo>
